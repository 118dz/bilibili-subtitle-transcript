{
  "manifest_version": 3,
  "name": "视频字幕稿",
  "short_name": "字幕稿",
  "description": "从 B 站和 YouTube 视频页读取字幕，并整理为可复制的文字稿。",
  "version": "1.3.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "读取视频字幕稿",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*",
    "*://*.bilivideo.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/bangumi/play/*",
        "https://www.youtube.com/watch*",
        "https://m.youtube.com/watch*",
        "https://www.youtube.com/shorts/*",
        "https://m.youtube.com/shorts/*",
        "https://youtu.be/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
